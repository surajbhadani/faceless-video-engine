# Copy this file to .env and fill in your keys.

# FREE — get at https://aistudio.google.com/apikey  (Google account, no card needed)
GEMINI_API_KEY=

# FREE — get at https://www.pexels.com/api/  (sign up, instant key)
PEXELS_API_KEY=

# OPTIONAL, FREE — a YouTube Data API key (same Cloud project as the upload setup).
# Only used as a fallback for public view counts when the Analytics API returns
# nothing yet (its data lags 24-48h behind an upload). Safe to leave blank.
YOUTUBE_API_KEY=

# OPTIONAL, FREE — AI scene-image generation, tried in this order before
# falling back to keyless Pollinations (slow, ~45s/image rate limit).
# Leave any of these blank to skip that backend.

# Hugging Face Inference API (FLUX.1-schnell) — free account, no card needed.
# Get a token at https://huggingface.co/settings/tokens (read access is enough).
HF_API_TOKEN=

# Cloudflare Workers AI (FLUX/SDXL) — free account, 10,000 neurons/day, no card.
# Account ID: https://dash.cloudflare.com -> right sidebar of any domain/overview.
# API token: https://dash.cloudflare.com/profile/api-tokens -> "Workers AI" template.
CF_ACCOUNT_ID=
CF_API_TOKEN=
